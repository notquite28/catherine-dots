source /home/quiet/.config/zsh/.zshrc

# Local secrets and machine-specific overrides, not managed by chezmoi
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Hermes Agent — ensure ~/.local/bin is on PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="/home/quiet/.bun/bin:$PATH"
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"

# pnpm
export PNPM_HOME="/home/quiet/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
export JAVA_HOME=/opt/android-studio/jbr

# bun completions
[ -s "/home/quiet/.bun/_bun" ] && source "/home/quiet/.bun/_bun"

# Claude Code — skip permission prompts
alias cc="claude --dangerously-skip-permissions"


# >>> omp profile alias: ave >>>
ave() {
    command '/home/quiet/.bun/bin/bun' '/home/quiet/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent/dist/cli.js' --profile=avemujica-chatgpt "$@"
}
# <<< omp profile alias: ave <<<


# >>> omp profile alias: grk >>>
grk() {
    command '/home/quiet/.bun/bin/bun' '/home/quiet/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent/dist/cli.js' --profile=grok-build "$@"
}
# <<< omp profile alias: grk <<<

# >>> omp profile alias: qwen >>>
qwen() {
    command '/home/quiet/.bun/bin/bun' '/home/quiet/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent/dist/cli.js' --profile=qwen "$@"
}
# <<< omp profile alias: qwen <<<

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<
